{
  "info": {
    "name": "spring-api-gateway",
    "description": "Demo collection for the Spring Cloud Gateway + JWT microservices project. Run requests top to bottom: Register -> Login (auto-saves the JWT) -> everything else uses it automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "jwt", "value": "" },
    { "key": "testEmail", "value": "" }
  ],
  "item": [
    {
      "name": "1. Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"Password123!\",\n  \"name\": \"Demo User\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.collectionVariables.set('testEmail', 'demo_' + Date.now() + '@example.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "pm.test('Returns user id and USER role', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('id');",
              "  pm.expect(body.role).to.eql('USER');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Login (saves JWT)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"Password123!\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Returns a Bearer token', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.tokenType).to.eql('Bearer');",
              "  pm.expect(body.token).to.be.a('string').and.not.empty;",
              "  pm.collectionVariables.set('jwt', body.token);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Profile - no token (expect 401)",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/users/profile", "host": ["{{baseUrl}}"], "path": ["users", "profile"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 401 (gateway rejects, never reaches user-service)', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Profile - with token",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
        "url": { "raw": "{{baseUrl}}/users/profile", "host": ["{{baseUrl}}"], "path": ["users", "profile"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Email matches logged-in user', () => {",
              "  pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get('testEmail'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Create product",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwt}}" }
        ],
        "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Demo Widget\",\n  \"price\": 29.99,\n  \"quantity\": 10\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "pm.test('createdBy matches the JWT subject (header propagation proof)', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('createdBy');",
              "  pm.collectionVariables.set('productId', body.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6. List products (paginated)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
        "url": {
          "raw": "{{baseUrl}}/products?page=0&size=5",
          "host": ["{{baseUrl}}"],
          "path": ["products"],
          "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "5" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Response is a paginated page', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('content');",
              "  pm.expect(body).to.have.property('totalElements');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Profile - bad token (expect 401)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer garbage.invalid.token" }],
        "url": { "raw": "{{baseUrl}}/users/profile", "host": ["{{baseUrl}}"], "path": ["users", "profile"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 401 (signature verification fails)', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Gateway health check",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/actuator/health", "host": ["{{baseUrl}}"], "path": ["actuator", "health"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 and UP', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().status).to.eql('UP');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
